{
  "$schema": "https://biomejs.dev/schemas/2/biome.schema.json",
  "extends": ["biome-config-shaunburdick"],
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      "!**/*.tsbuildinfo",
      "!europa-source",
      "!**/pnpm-lock.yaml",
      "!**/contracts",
      "!**/tests/fixtures/golden-1000-tick.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "warn"
      },
      "style": {
        "noMagicNumbers": "warn",
        "useBlockStatements": "warn",
        "useConsistentArrayType": "warn",
        "useConsistentMemberAccessibility": "warn",
        "useDestructuring": "warn",
        "useNamingConvention": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDebugger": "error",
        "noBitwiseOperators": "warn",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["warn", "error"]
          }
        }
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  }
}
