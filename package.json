{
    "name": "@europa/root",
    "version": "0.2.0",
    "private": true,
    "description": "Europa Neo monorepo root — pnpm workspaces hosting the server-authoritative game engine, server, client console, and shared types.",
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "engines": {
        "node": ">=22.0.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "clean": "pnpm --filter './packages/*' run clean",
        "build": "pnpm -r --filter './packages/*' build",
        "test": "pnpm -r --filter './packages/*' test",
        "lint": "pnpm -r --filter './packages/*' lint",
        "format": "pnpm -r --filter './packages/*' format",
        "format:check": "pnpm -r --filter './packages/*' format:check",
        "typecheck": "pnpm build && pnpm -r --filter './packages/*' typecheck",
        "coverage": "pnpm -r --filter './packages/*' coverage",
        "version:check": "pnpm --filter @europa/version version:check",
        "host": "pnpm --filter @europa/console host",
        "replay:capture": "tsx packages/engine/scripts/capture.ts",
        "replay:run": "tsx packages/engine/scripts/run.ts",
        "replay:update": "tsx packages/engine/scripts/update.ts",
        "guard:config": "tsx scripts/check-orphaned-vitest-configs.ts",
        "guard:specs": "tsx scripts/check-spec-consolidation.ts",
        "verify": "bash scripts/verify.sh",
        "verify:changed": "bash scripts/verify-changed.sh",
        "prepare": "husky"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "biome-config-shaunburdick": "catalog:",
        "@vitest/coverage-v8": "^4.1.11",
        "typescript": "catalog:",
        "husky": "catalog:",
        "tsx": "catalog:"
    }
}
