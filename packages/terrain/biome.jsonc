{
    "root": false,
    "extends": ["../../biome.jsonc"],
    "files": {
        "includes": ["src/**", "tests/**", "*.ts", "*.json", "*.jsonc", "!src/contracts"]
    },
    "overrides": [
        {
            // Integer noise/hash math and seed fixtures intentionally use bitwise operations.
            "includes": [
                "src/elevation.ts",
                "src/fbm.ts",
                "src/generate.ts",
                "src/hash.ts",
                "src/rng-adapter.ts",
                "src/value-noise.ts",
                "tests/fixtures/seeds.ts",
                "tests/unit/elevation.test.ts",
                "tests/unit/fbm.test.ts",
                "tests/unit/rng-adapter.test.ts",
                "tests/unit/seed-fixtures.test.ts",
                "tests/unit/value-noise.test.ts",
                "tests/unit/water.test.ts"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noBitwiseOperators": "off"
                    }
                }
            },
            "assist": { "actions": { "source": { "organizeImports": "off" } } }
        },
        {
            "includes": [
                "src/fbm.ts",
                "src/hash.ts",
                "src/rng-adapter.ts",
                "src/value-noise.ts",
                "tests/fixtures/seeds.ts",
                "tests/unit/elevation.test.ts",
                "tests/unit/fbm.test.ts",
                "tests/unit/rng-adapter.test.ts",
                "tests/unit/seed-fixtures.test.ts",
                "tests/unit/value-noise.test.ts",
                "tests/unit/water.test.ts",
                "tests/fixtures/board.ts",
                "tests/integration/balance.test.ts",
                "tests/integration/clamp-integration.test.ts",
                "tests/integration/contract-conformance.test.ts",
                "tests/integration/determinism.test.ts",
                "tests/integration/sc-001-determinism.test.ts",
                "tests/integration/sc-002-balance.test.ts",
                "tests/integration/sc-003-performance.test.ts",
                "tests/unit/board-fixtures.test.ts",
                "tests/unit/board.test.ts",
                "tests/unit/city-band.test.ts",
                "tests/unit/city-placement.test.ts",
                "tests/unit/city-symmetry.test.ts",
                "tests/unit/symmetry.test.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noMagicNumbers": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "tests/contracts-drift.test.ts",
                "tests/unit/clamp.test.ts",
                "tests/unit/generate.test.ts",
                "tests/unit/index.test.ts",
                "tests/unit/settings.test.ts",
                "tests/unit/validate.test.ts"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noMagicNumbers": "off"
                    }
                }
            }
        },
        {
            "includes": ["tests/unit/validate.test.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noBitwiseOperators": "off"
                    }
                }
            }
        },
        {
            // Contract mirror formatting is protected by byte-identity tests.
            "includes": ["src/contracts/**"],
            "formatter": { "enabled": false },
            "linter": {
                "rules": {
                    "correctness": { "noUnusedImports": "off" },
                    "style": { "useConsistentArrayType": "off" },
                    "suspicious": { "noConfusingVoidType": "off" }
                }
            }
        }
    ]
}
