{
    "name": "@europa/logging",
    "version": "0.2.0",
    "private": true,
    "description": "Europa Neo structured logging — Logger interface, createLogger factory (JSON + pretty), NULL_LOGGER no-op, and sanitizeLogText utility. Zero dependencies; Node.js builtins only.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "@vitest/coverage-v8": "^4.1.11",
        "tsup": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
