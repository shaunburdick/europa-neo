{
    "name": "@europa/version",
    "version": "0.1.0",
    "private": true,
    "description": "Europa Neo shared application version — owns the single-source APP_VERSION constant (feature 009) so every guarded surface projects one release identity.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --coverage",
        "version:check": "tsx scripts/check-version-drift.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@vitest/coverage-v8": "^4.1.11",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
