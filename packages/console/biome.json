{
  "root": false,
  "extends": ["../../biome.json"],
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.ts",
      "*.json",
      "!contracts",
      "!test-results"
    ]
  },
  "linter": {
    "rules": {
      "a11y": {
        "useSemanticElements": "off",
        "useFocusableInteractive": "off",
        "noNoninteractiveTabindex": "off"
      }
    }
  }
}
