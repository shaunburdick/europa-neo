{
    // Package-scoped Biome policy: extends the root configuration (which
    // itself layers biome-config-shaunburdick).
    "root": false,
    "extends": ["../../biome.jsonc"],
    "files": {
        "includes": ["src/**", "tests/**", "scripts/**", "*.ts", "*.json", "*.jsonc"]
    },
    "overrides": [
        {
            // FR-016 a11y gates: reduced-motion suppression must use
            // !important to override decorative animations regardless of
            // specificity (WCAG 2.3.3); the global rule is the normative
            // implementation of the contract's media query.
            "includes": ["src/styles/catalog.css"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noImportantStyles": "off"
                    }
                }
            }
        },
        {
            // Modal backdrop is a full-screen interactive overlay, not a
            // semantic button. Using <button> would wrap the entire dialog
            // (invalid HTML nesting). role="button" + onKeyDown satisfies
            // the a11y contract while useSemanticElements cannot apply here.
            "includes": ["src/components/generic/modal.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "useSemanticElements": "off"
                    }
                }
            }
        }
    ]
}
