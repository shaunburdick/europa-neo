{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": "./src",
        "noEmit": false,
        "composite": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules", "coverage", "tests"]
}
