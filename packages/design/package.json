{
    "name": "@europa/design",
    "version": "0.1.0",
    "private": true,
    "description": "Europa Neo shared design system — authoritative tokens and reusable component/layout primitives for the console and the player manual. Single stylesheet source plus typed TypeScript token exports.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.js"
        },
        "./dist/design.css": "./dist/design.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsx scripts/build-css.ts --emit-module && tsup && tsx scripts/generate-brand.ts && tsx scripts/build-css.ts && tsx scripts/vendor-to-docs.ts",
        "dev": "vite playground",
        "dev:build": "pnpm build && vite preview playground",
        "vendor": "tsx scripts/vendor-to-docs.ts",
        "check:no-literals": "tsx scripts/check-no-literals.ts",
        "check:vendor-identity": "tsx scripts/check-vendor-identity.ts",
        "check:component-catalog": "tsx scripts/check-component-catalog.ts",
        "check:bundle-size": "tsx scripts/check-bundle-size.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@types/node": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "happy-dom": "catalog:",
        "@resvg/resvg-js": "catalog:",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:"
    }
}
