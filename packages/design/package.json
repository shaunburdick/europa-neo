{
    "name": "@europa/design",
    "version": "0.1.0",
    "private": true,
    "description": "Europa Neo shared design system — authoritative tokens and reusable component/layout primitives for the console and the player manual. Single stylesheet source plus typed TypeScript token exports.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup && tsx scripts/build-css.ts && tsx scripts/vendor-to-docs.ts",
        "vendor": "tsx scripts/vendor-to-docs.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
