{
    "name": "@europa/design",
    "version": "0.2.0",
    "private": true,
    "description": "Europa Neo shared design system — authoritative tokens and reusable component/layout primitives for the console and the player manual. Single stylesheet source plus typed TypeScript token exports.",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tokens": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./components": {
            "types": "./dist/components/index.d.ts",
            "import": "./dist/components/index.js"
        },
        "./brand": {
            "types": "./dist/brand/index.d.ts",
            "import": "./dist/brand/index.js"
        },
        "./brand/*": "./dist/brand/*",
        "./dist/design.css": "./dist/design.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsup && tsx scripts/generate-brand.ts && tsx scripts/build-css.ts && tsx scripts/generate-contrast-notes.ts && tsx scripts/vendor-to-docs.ts && tsx scripts/assert-brand-output.ts && pnpm check:brand-types && tsx scripts/check-brand-surface.ts",
        "dev": "vite dev --config dev/vite.config.ts",
        "dev:build": "pnpm build && vite preview --config dev/vite.config.ts",
        "vendor": "tsx scripts/vendor-to-docs.ts",
        "stage:manual": "tsx scripts/vendor-to-docs.ts",
        "check:no-literals": "tsx scripts/check-no-literals.ts",
        "check:vendor-identity": "tsx scripts/check-vendor-identity.ts",
        "check:component-catalog": "tsx scripts/check-component-catalog.ts",
        "check:bundle-size": "tsx scripts/check-bundle-size.ts",
        "check:brand-surface": "tsx scripts/check-brand-surface.ts",
        "check:contrast-notes": "tsx scripts/check-contrast-notes.ts",
        "check:brand-types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck tests/brand/package-surface.types.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "biome check .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "typecheck": "tsc --noEmit",
        "coverage": "vitest run --coverage"
    },
    "devDependencies": {
        "@biomejs/biome": "catalog:",
        "@testing-library/dom": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/react": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/node": "catalog:",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "happy-dom": "catalog:",
        "@resvg/resvg-js": "catalog:",
        "tsup": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vite": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    }
}
